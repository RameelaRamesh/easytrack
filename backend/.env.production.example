# EasyTrack Production Environment Configuration
# Copy this file to .env on your VPS server (/var/www/easytrack/backend/.env)

# Security Settings
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_50_CHARS_LONG
DEBUG=False
ALLOWED_HOSTS=easytrack.vattarasolutions.com,147.93.107.43,localhost,127.0.0.1
SECURE_SSL_REDIRECT=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# PostgreSQL Database Configuration
DB_NAME=easytrack_db
DB_USER=easytrack_user
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD
DB_HOST=db
DB_PORT=5432

# CORS Config
CORS_ALLOWED_ORIGINS=https://easytrack.vattarasolutions.com,http://easytrack.vattarasolutions.com,http://147.93.107.43

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=operations@vattarasolutions.com
EMAIL_HOST_PASSWORD=YOUR_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=operations@vattarasolutions.com
